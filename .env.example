# Copie para .env.local e preencha com os dados do seu projeto Supabase.
# O .env.local é ignorado pelo git; este arquivo de exemplo não contém segredos.
#
# Project Settings -> Data API -> Project URL (só o domínio, sem /rest/v1)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
# Project Settings -> API Keys -> chave publishable (sb_publishable_...)
# É pública por natureza: quem protege a tabela é a Row Level Security.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
